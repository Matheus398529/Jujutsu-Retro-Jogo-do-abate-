local function monitorarPlayer(plr)
    if plr.Name ~= ALVO then return end
    if plr.Character then
        task.spawn(monitorarPersonagem, plr.Character)
    end
    table.insert(avisoConns, plr.CharacterAdded:Connect(monitorarPersonagem))
end

local function setAviso(on)
    avisoEnabled = on
    for _, c in ipairs(avisoConns) do c:Disconnect() end
