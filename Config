--// Verificação por cor do PointLight
local function closeTo(r, g, b, t)
    return math.abs(r - t[1]) <= COLOR_TOLERANCE
        and math.abs(g - t[2]) <= COLOR_TOLERANCE
        and math.abs(b - t[3]) <= COLOR_TOLERANCE
end

local function matchesSelection(obj)
    if selected == "Nenhum" then return true end

    local light = obj:FindFirstChildWhichIsA("PointLight", true)
    if not light then return false end

    local r = math.round(light.Color.R * 255)
    local g = math.round(light.Color.G * 255)
    local b = math.round(light.Color.B * 255)

    if selected == "Legendary" then
        return closeTo(r, g, b, LEGENDARY_COLOR)
    elseif selected == "Mystic" then
        return r >= 180 and g <= 90 and b <= 90
    elseif selected == "Épico" then
        local h, s, v = light.Color:ToHSV()
        return h >= 0.72 and h <= 0.89 and s >= 0.25 and v >= 0.25
    elseif selected == "Incomum" then
        return closeTo(r, g, b, INCOMUM_COLOR)
    elseif selected == "Comum" then
        return closeTo(r, g, b, COMUM_COLOR)
    end
    return false
end

local function getRoot()
    local char = LP.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getTargetCF(obj, prompt)
    local pp = prompt.Parent
    if pp and pp:IsA("BasePart") then
        return pp.CFrame
    elseif obj:IsA("Model") then
        return obj:GetPivot()
    end
end

local function teleportNext()
    local now = os.clock()
    if now - lastUse < COOLDOWN then return end
    lastUse = now

    local root = getRoot()
    if not root then
        warn("[Admin V2 Hub] Personagem não encontrado.")
        return
    end

    local folder = workspace:FindFirstChild("CullingLoot")
    if not folder then
        warn("[Admin V2 Hub] Pasta CullingLoot não encontrada no workspace.")
        showMsg("Não tem mais nenhum")
        return
    end

    local bestObj, bestCF, bestDist
    for _, obj in ipairs(folder:GetChildren()) do
        if obj.Name == "CursedObject" and not visited[obj] and matchesSelection(obj) then
            local prompt = obj:FindFirstChild("LootPrompt", true)
            if prompt and prompt:IsA("ProximityPrompt") then
                local cf = getTargetCF(obj, prompt)
                if cf then
                    local dist = (cf.Position - root.Position).Magnitude
                    if dist <= MAX_DISTANCE and (not bestDist or dist < bestDist) then
                        bestObj, bestCF, bestDist = obj, cf, dist
                    end
                end
            end
        end
    end

    if not bestObj then
        showMsg("Não tem mais nenhum")
        return
    end

    visited[bestObj] = true
    root.CFrame = bestCF + Vector3.new(0, 2, 0)
end

